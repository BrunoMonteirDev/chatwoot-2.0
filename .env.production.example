# Required: public domains with DNS A/AAAA records pointed at the VPS.
APP_DOMAIN=chat.example.com
BRIDGE_DOMAIN=bridge.example.com
FRONTEND_URL=https://chat.example.com
BRIDGE_PUBLIC_URL=https://bridge.example.com

# Images published by GitHub Actions to GitHub Container Registry (GHCR).
CHATWOOT_RAILS_IMAGE=ghcr.io/brunomonteirdev/chatwoot-backend:main
CHATWOOT_FRONTEND_IMAGE=ghcr.io/brunomonteirdev/chatwoot-2.0-frontend:main
CHATWOOT_BRIDGE_IMAGE=ghcr.io/brunomonteirdev/chatwoot-2.0-bridge:main

# Required: generate unique production secrets. Never commit this file after copying it to .env.production.
POSTGRES_DATABASE=chatwoot_production
POSTGRES_USERNAME=postgres
POSTGRES_PASSWORD=
REDIS_PASSWORD=
SECRET_KEY_BASE=
BRIDGE_ENCRYPTION_KEY=
BRIDGE_WAHA_SESSION_OWNERSHIP_FILE=/app/bridge/data/waha-session-ownerships.json
BRIDGE_WEBHOOK_SECRET=
WAHA_API_KEY=
WAHA_WEBHOOK_SECRET=
META_WEBHOOK_VERIFY_TOKEN=

# Bridge ↔ Chatwoot configuration. Account routing is automatic per inbox.
CHATWOOT_ACCOUNT_ID=
# Optional legacy override. Leave empty: the bridge creates and retrieves its
# own internal service credential automatically after deployment.
CHATWOOT_API_ACCESS_TOKEN=
BRIDGE_ALLOWED_ORIGINS=https://chat.example.com
BRIDGE_MAX_MEDIA_BYTES=33554432
WAHA_DEFAULT_ENGINE=GOWS
# Manual Chatwoot import reads only the history already stored by GOWS.
WAHA_HISTORY_PAGE_SIZE=100
WAHA_HISTORY_MESSAGE_CONCURRENCY=4
# Pairing-time GOWS sync limits. Changing these does not import anything and
# can require a new/repaired session; set them deliberately for old numbers.
WAHA_GOWS_DEVICE_REQUIRE_FULL_SYNC=false
WAHA_GOWS_DEVICE_HISTORY_SYNC_FULL_SYNC_DAYS_LIMIT=
WAHA_GOWS_DEVICE_HISTORY_SYNC_RECENT_SYNC_DAYS_LIMIT=
WAHA_GOWS_DEVICE_HISTORY_SYNC_INITIAL_SYNC_MAX_MESSAGES_PER_CHAT=
WAHA_GOWS_DEVICE_HISTORY_SYNC_FULL_SYNC_SIZE_MB_LIMIT=
WAHA_GOWS_DEVICE_HISTORY_SYNC_STORAGE_QUOTA_MB=

# Required by Chatwoot.
RAILS_ENV=production
NODE_ENV=production
FORCE_SSL=true
ENABLE_ACCOUNT_SIGNUP=false
POSTGRES_HOST=postgres
REDIS_URL=redis://:${REDIS_PASSWORD}@redis:6379

# Optional legacy Evolution.
EVOLUTION_BASE_URL=
EVOLUTION_API_KEY=

# Optional Meta Cloud / Embedded Signup.
META_GRAPH_VERSION=v22.0
META_APP_ID=
META_APP_SECRET=
META_EMBEDDED_SIGNUP_CONFIG_ID=
