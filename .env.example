# Desenvolvimento: destino do proxy Vite. O Rails local usa a porta 3000 em
# chatwoot/Procfile.dev declara a porta 3000, mas ela está ocupada localmente
# por outro serviço neste workspace. Use uma porta livre para o Rails, por
# exemplo 3002. Esta URL nunca é usada diretamente pelos componentes.
VITE_CHATWOOT_PROXY_TARGET="http://localhost:3002"
# Servidor Vite do backend, necessário para as páginas Rails (incluindo o
# console de Super Admin) em desenvolvimento.
VITE_CHATWOOT_VITE_TARGET="http://localhost:3036"

# Mantenha vazio no desenvolvimento com proxy: o navegador chama /auth e /api
# como caminhos relativos. Em produção, prefira reverse proxy/BFF same-origin.
VITE_CHATWOOT_BASE_URL=""

# O console usa /super_admin pelo proxy do Vite. Defina uma URL externa apenas
# se frontend e backend estiverem em origens diferentes.
# VITE_SUPER_ADMIN_URL="https://chatwoot.exemplo.com/super_admin"

# Não inclua senhas, access-token, api_access_token ou chaves privadas em
# variáveis VITE_: elas são expostas no bundle do navegador.

# URL pública do bridge usada pela UI. A UI nunca recebe a chave da Evolution
# nem o segredo de webhook: operações administrativas usam a sessão Chatwoot.
# Produção: HTTPS público. Desenvolvimento Linux com Chatwoot Docker:
# VITE_BRIDGE_PUBLIC_URL="http://172.21.0.1:3100"
VITE_BRIDGE_PUBLIC_URL="https://bridge.example.com"

# Bridge Evolution -> Chatwoot. Estas variáveis são exclusivamente server-side.
CHATWOOT_BASE_URL="http://localhost:3000"
CHATWOOT_ACCOUNT_ID=""
CHATWOOT_API_ACCESS_TOKEN=""
EVOLUTION_BASE_URL="http://localhost:8080"
EVOLUTION_API_KEY=""
# WAHA is optional while Evolution is still active. These values are consumed
# only by the bridge and docker-compose.waha.yml; never create VITE_WAHA_*.
WAHA_BASE_URL="http://localhost:3001"
# Porta publicada apenas para administração local. Em produção deixe WAHA
# interno na rede Docker e use WAHA_BASE_URL="http://waha:3000" no bridge.
WAHA_HOST_PORT="3001"
WAHA_API_KEY=""
WAHA_WEBHOOK_SECRET="gere-outro-segredo-longo"
WAHA_DEFAULT_ENGINE="GOWS"
WAHA_REQUEST_TIMEOUT_MS="15000"
# Consulta manual do histórico já sincronizado no GOWS. Nunca inicia sync,
# não reinicia a sessão e não altera os parâmetros abaixo.
WAHA_HISTORY_PAGE_SIZE="100"
WAHA_HISTORY_MESSAGE_CONCURRENCY="4"
# BRIDGE_WAHA_HISTORY_FILE="./bridge/data/waha-history-imports.json"
# Profundidade do sync WhatsApp → GOWS durante o pareamento. Ajuste somente
# antes de criar/reparear uma sessão; isto é diferente de importar para o
# Chatwoot e pode aumentar bastante o uso de disco.
# WAHA_GOWS_DEVICE_REQUIRE_FULL_SYNC="false"
# WAHA_GOWS_DEVICE_HISTORY_SYNC_FULL_SYNC_DAYS_LIMIT=""
# WAHA_GOWS_DEVICE_HISTORY_SYNC_RECENT_SYNC_DAYS_LIMIT=""
# WAHA_GOWS_DEVICE_HISTORY_SYNC_INITIAL_SYNC_MAX_MESSAGES_PER_CHAT=""
# WAHA_GOWS_DEVICE_HISTORY_SYNC_FULL_SYNC_SIZE_MB_LIMIT=""
# WAHA_GOWS_DEVICE_HISTORY_SYNC_STORAGE_QUOTA_MB=""
BRIDGE_PORT="3100"
BRIDGE_PUBLIC_URL="https://bridge.example.com"
BRIDGE_WEBHOOK_SECRET="gere-um-segredo-longo"
# BRIDGE_DEDUP_FILE="./bridge/data/evolution-message-ids.json"
# BRIDGE_IDENTITY_FILE="./bridge/data/evolution-identities.json"
# Durable WAHA session ownership. Production stores this encrypted in Redis;
# this file fallback must live in the persistent bridge_data volume.
# BRIDGE_WAHA_SESSION_OWNERSHIP_FILE="./bridge/data/waha-session-ownerships.json"
# Meta Cloud credentials are sent only to the bridge setup endpoint and stored
# in this development-only server-side file (never use VITE_META_* variables).
META_GRAPH_VERSION="v22.0"
# Embedded Signup v4: App ID e Configuration ID são retornados pelo bridge
# somente para iniciar o SDK. App Secret e tokens nunca chegam ao navegador.
META_APP_ID=""
META_APP_SECRET=""
META_EMBEDDED_SIGNUP_CONFIG_ID=""
# META_EMBEDDED_SIGNUP_SESSION_TTL_SECONDS="600"
# BRIDGE_META_CONFIG_FILE="./bridge/data/meta-cloud-config.json"
# Temporary, server-side-only history staging. It is not a Chatwoot import.
# BRIDGE_META_HISTORY_FILE="./bridge/data/meta-history-staging.json"
# Required for a public Meta webhook in production. Keep both server-side;
# META_WEBHOOK_VERIFY_TOKEN may use BRIDGE_WEBHOOK_SECRET only in local MVP.
META_WEBHOOK_VERIFY_TOKEN=""
# Produção: estado compartilhado e segredos criptografados no bridge.
# Use a URL Redis com TLS/autenticação quando oferecida pelo provedor e uma
# chave aleatória longa, exclusiva do bridge (não é uma variável VITE_).
BRIDGE_REDIS_URL="redis://:senha@redis:6379/0"
BRIDGE_ENCRYPTION_KEY="gere-uma-chave-aleatoria-longa-e-exclusiva"
BRIDGE_ALLOWED_ORIGINS="https://app.example.com"
HISTORY_IMPORT_BATCH_SIZE="100"
HISTORY_MEDIA_CONCURRENCY="3"
# Limite server-side aplicado ao download/upload de mídia por transport.
BRIDGE_MAX_MEDIA_BYTES="33554432"
